# Bu dosyayı .env olarak kopyalayıp doldur. .env asla commit'lenmez.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Transkript dil tercihi (sırayla denenir)
TRANSCRIPT_LANGUAGES=tr,en

# Başarılı /api/summary ve /api/questions yanıtları backend/runs/ altına kaydedilir
SAVE_RUNS=true
# Kayıt klasörünü değiştirmek için (varsayılan: backend/runs)
# RUNS_DIR=
